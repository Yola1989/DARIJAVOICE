rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminEmail() {
      return signedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'younes.ahdidou@gmail.com',
          'younes.ahdidou@googlemail.com'
        ];
    }
    function adminRole() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isAdmin() { return adminEmail() || adminRole(); }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if owner(userId) || isAdmin();
      // Profiles, balances, roles and account status are server-only writes.
      allow create, update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    match /generations/{generationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /generation_locks/{userId} {
      allow read, write: if false;
    }

   match /subscription_requests/{requestId} {
  allow read: if signedIn() &&
    (resource.data.userId == request.auth.uid || isAdmin());

  allow create, update, delete: if false;
}

    match /reviews/{reviewId} {
  allow read: if (
    resource.data.isVisible == true &&
    resource.data.moderationStatus == 'approved'
  ) || isAdmin();

  allow create, update, delete: if false;
}

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
